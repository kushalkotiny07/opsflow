{
  "name": "taskos-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf .next build && node node_modules/next/dist/bin/next dev",
    "build": "rm -rf .next && node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "test": "node --import tsx --test src/lib/non-api-labs/__tests__/*.test.ts",
    "db:seed": "node node_modules/.bin/tsx prisma/seed.ts",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "dummy:generate": "node docker/labstack-dummy/generate-seed.mjs",
    "dummy:up": "docker compose -f docker-compose.yml -f docker-compose.labstack-dummy.yml up -d --build",
    "dummy:down": "docker compose -f docker-compose.yml -f docker-compose.labstack-dummy.yml down",
    "dummy:reseed": "docker compose -f docker-compose.yml -f docker-compose.labstack-dummy.yml exec -T labstack-db psql -v ON_ERROR_STOP=1 -U ${LABSTACK_DB_USER:-labstack} -d ${LABSTACK_DB_NAME:-labstack} -f /docker-entrypoint-initdb.d/02-seed.sql",
    "dummy:psql": "docker compose -f docker-compose.yml -f docker-compose.labstack-dummy.yml exec labstack-db psql -U ${LABSTACK_DB_USER:-labstack} -d ${LABSTACK_DB_NAME:-labstack}",
    "dummy:realign": "sh docker/labstack-dummy/realign.sh",
    "dummy:team": "node node_modules/.bin/tsx prisma/seed_dummy_team.ts",
    "dummy:labs": "node node_modules/.bin/tsx prisma/seed_dummy_lab_configs.ts",
    "dummy:activity": "node node_modules/.bin/tsx prisma/seed_dummy_activity.ts",
    "wa:test-sla": "node node_modules/.bin/tsx prisma/test_wa_sla_breach.ts",
    "wa:test-breach": "tsx prisma/test_provider_breach.ts",
    "wa:test-features": "tsx prisma/test_features_e2e.ts",
    "wa:test-cloud-api": "node scripts/test-whatsapp-cloud-api.mjs",
    "wa:test-sla-milestone": "tsx prisma/test_sla_milestone_breach.ts",
    "wa:smoke": "node node_modules/.bin/tsx prisma/smoke_poll.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.2",
    "next": "^15.0.0",
    "node-cron": "^4.2.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@prisma/client": "^4.16.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^4.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
