generator client {
  provider      = "prisma-client-js"
  // `native` for local dev (darwin-arm64). The Docker image is Debian
  // bookworm-slim with OpenSSL 3, so both arm64 and x86_64 variants of
  // the linux glibc target are bundled — Prisma picks the right one at
  // runtime based on the host arch.
  // Bullseye ships OpenSSL 1.1, not 3.0. Targets cover both arm64 and
  // amd64 on Debian bullseye.
  binaryTargets = ["native", "linux-arm64-openssl-1.1.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  OPS_HEAD
  OPS_ADMIN // full super-admin powers (coerced to OPS_HEAD for authorization); distinct label only
  STORE_ADMIN
  OPS_AGENT
}

enum TaskStatus {
  CREATED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  BLOCKED
  BREACHED
  CANCELLED
  REASSIGNED
}

enum TaskPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum TaskRuleTriggerType {
  STATUS // Create task when order reaches a specific status
  TIME // Create task only when time conditions are met
}

enum AssignmentMode {
  ROUND_ROBIN
  LOAD_BALANCED
  PRIORITY_ONLY
}

enum AlertType {
  SLA_WARNING
  SLA_URGENT
  SLA_BREACHED
  TASK_UNASSIGNED
  ESCALATION
  AGENT_AT_CAPACITY
  ORDER_STUCK
  SKILL_GAP
  DAILY_SUMMARY
  // Emitted by lib/engine/sourceHealthWatcher when a data source has been
  // failing, silent, or producing zero rows for too long. Resolved when
  // health recovers.
  SOURCE_HEALTH
}

enum AlertChannel {
  IN_APP
  EMAIL
  SMS
}

enum AlertStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  DISMISSED
}

enum RosterStatus {
  ACTIVE
  ON_FIELD
  ON_LEAVE
  OFF
}

// ─────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teamMember              TeamMember?
  sessions                Session[]
  assignedTasks           Task[]                @relation("AssignedTo")
  taskHistory             TaskHistory[]
  notifyLevels            EscalationLevel[]
  savedFilters            UserSavedFilter[]
  ruleAudits              TaskRuleAudit[] // P4: who changed rules
  dataSourcesCreated      DataSource[]          @relation("DataSourceCreatedBy")
  ruleSourceScopesCreated TaskRuleSourceScope[] @relation("RuleSourceScopeCreatedBy")
  alerts                  Alert[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model UserSavedFilter {
  id         Int      @id @default(autoincrement())
  userId     Int
  filterName String   @db.VarChar(255)
  filterJson Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  usageCount Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, filterName])
  @@index([userId])
  @@index([usageCount(sort: Desc)])
  @@map("user_saved_filters")
}

// ─────────────────────────────────────────────
// TEAM MANAGEMENT
// ─────────────────────────────────────────────

model TeamMember {
  id                 Int            @id @default(autoincrement())
  userId             Int            @unique
  maxConcurrentTasks Int            @default(100)
  isActive           Boolean        @default(true)
  autoAssignEnabled  Boolean        @default(true)
  assignmentPriority Int            @default(5)
  assignmentMode     AssignmentMode @default(ROUND_ROBIN)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills           TeamMemberSkill[]
  storeAssignments StoreAssignment[]
  dailyRosters     DailyRoster[]
  assignedTasks    Task[]
  capabilities     TeamMemberCapability[]
  weeklySchedules  WeeklySchedule[]
  rosterExceptions RosterException[]

  @@map("team_members")
}

/// Links a team member to a labstack Store (by store id)
model StoreAssignment {
  id           Int @id @default(autoincrement())
  teamMemberId Int
  storeId      Int // references labstack public."Store".id

  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, storeId])
  @@map("store_assignments")
}

model SkillTag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  label String

  skills    TeamMemberSkill[]
  taskRules TaskRuleSkill[]

  @@map("skill_tags")
}

model TeamMemberSkill {
  teamMemberId Int
  skillTagId   Int

  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  skillTag   SkillTag   @relation(fields: [skillTagId], references: [id], onDelete: Cascade)

  @@id([teamMemberId, skillTagId])
  @@map("team_member_skills")
}

model DailyRoster {
  id           Int          @id @default(autoincrement())
  teamMemberId Int
  date         DateTime     @db.Date
  status       RosterStatus @default(ACTIVE)
  note         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  member TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, date])
  @@map("daily_rosters")
}

// ─────────────────────────────────────────────
// TEAM MEMBER CAPABILITIES (data source handling)
// ─────────────────────────────────────────────

model TeamMemberCapability {
  id           Int      @id @default(autoincrement())
  teamMemberId Int
  dataSourceId String
  assignedAt   DateTime @default(now())
  assignedBy   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  dataSource DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, dataSourceId])
  @@index([teamMemberId])
  @@index([dataSourceId])
  @@map("team_member_capabilities")
}

// ─────────────────────────────────────────────
// ROUND-ROBIN STATE (for load-balanced assignment)
// ─────────────────────────────────────────────

model RoundRobinState {
  id                   String   @id @default(cuid())
  dataSourceId         String
  lastAssignedMemberId Int?
  lastUpdatedAt        DateTime @updatedAt
  createdAt            DateTime @default(now())

  @@unique([dataSourceId])
  @@index([dataSourceId])
  @@map("round_robin_states")
}

// ─────────────────────────────────────────────
// ROSTER MANAGEMENT
// ─────────────────────────────────────────────

model WeeklySchedule {
  id           Int      @id @default(autoincrement())
  teamMemberId Int
  dayOfWeek    Int // 0=Sunday, 1=Monday, ..., 6=Saturday
  isWorking    Boolean  @default(true)
  startTime    String?  @db.VarChar(5) // HH:MM format
  endTime      String?  @db.VarChar(5) // HH:MM format
  breakStart   String?  @db.VarChar(5) // HH:MM format (optional)
  breakEnd     String?  @db.VarChar(5) // HH:MM format (optional)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, dayOfWeek])
  @@index([teamMemberId])
  @@index([dayOfWeek])
  @@map("weekly_schedules")
}

model RosterException {
  id           Int      @id @default(autoincrement())
  teamMemberId Int
  date         DateTime @db.Date
  status       String   @db.VarChar(20) // "ON_LEAVE" | "SICK" | "OFF"
  note         String?
  createdBy    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, date])
  @@index([teamMemberId])
  @@index([date])
  @@index([createdAt])
  @@map("roster_exceptions")
}

// ─────────────────────────────────────────────
// TASK TYPES & TEMPLATES
// ─────────────────────────────────────────────

model TaskType {
  id                   Int      @id @default(autoincrement())
  name                 String   @unique
  label                String
  description          String?
  normalAgingMinutes   Int      @default(30)
  warningAgingMinutes  Int      @default(45)
  criticalAgingMinutes Int      @default(60)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  checklistItems ChecklistTemplate[]
  rules          TaskRule[]
  tasks          Task[]

  @@map("task_types")
}

model ChecklistTemplate {
  id         Int      @id @default(autoincrement())
  taskTypeId Int
  stepOrder  Int
  stepText   String
  isRequired Boolean  @default(true)
  createdAt  DateTime @default(now())

  taskType TaskType @relation(fields: [taskTypeId], references: [id], onDelete: Cascade)

  @@map("checklist_templates")
}

// ─────────────────────────────────────────────
// TASK RULES
// ─────────────────────────────────────────────

model TaskRule {
  id                     String              @id @default(cuid())
  name                   String
  dataSourceId           String
  allowedTypes           Json                @default("[]")
  allowedStatuses        Json                @default("[]")
  pollingIntervalMinutes Int                 @default(15)
  taskTypeId             Int
  titleTemplate          String
  slaMinutes             Int
  priority               TaskPriority
  triggerType            TaskRuleTriggerType @default(TIME)
  triggerCondition       Json
  isActive               Boolean             @default(true)
  // W4.2 — How pickAssignee picks among eligible candidates. Stored as a
  // text column rather than a Prisma enum because adding new strategies
  // later (e.g. `geographic_proximity`, `language_match`) is a one-line
  // CHECK-constraint change instead of a typegen migration.
  // Allowed values: default | round_robin | store_affinity | skill_based | least_loaded
  assignmentStrategy     String              @default("default")
  escalationChainId      Int?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  dataSource      DataSource            @relation(fields: [dataSourceId], references: [id])
  taskType        TaskType              @relation(fields: [taskTypeId], references: [id])
  escalationChain EscalationChain?      @relation(fields: [escalationChainId], references: [id])
  requiredSkills  TaskRuleSkill[]
  tasks           Task[]
  sourceScopes    TaskRuleSourceScope[]

  @@map("task_rules")
}

model TaskRuleSkill {
  taskRuleId String
  skillTagId Int

  taskRule TaskRule @relation(fields: [taskRuleId], references: [id], onDelete: Cascade)
  skillTag SkillTag @relation(fields: [skillTagId], references: [id], onDelete: Cascade)

  @@id([taskRuleId, skillTagId])
  @@map("task_rule_skills")
}

// ── Task Rule Audit Trail (Phase 4) ────────────────────────
model TaskRuleAudit {
  id             Int      @id @default(autoincrement())
  ruleId         String
  changedById    Int?
  action         String // "CREATE", "UPDATE", "DELETE", "ACTIVATE", "DEACTIVATE"
  changesSummary Json? // What changed (before/after values)
  metadata       Json? // Additional info (ruleName, orderType, priority, etc)
  createdAt      DateTime @default(now())

  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([ruleId])
  @@index([createdAt])
  @@index([changedById])
  @@map("task_rule_audits")
}

// ─────────────────────────────────────────────
// TASKS
// ─────────────────────────────────────────────

model Task {
  id               Int          @id @default(autoincrement())
  taskRuleId       String
  taskTypeId       Int?
  title            String
  entityType       String // "ORDER"
  entityId         Int
  storeId          Int?
  orderType        String
  priority         TaskPriority
  status           TaskStatus   @default(CREATED)
  assignedToId     Int?
  teamMemberId     Int?
  assignedAt       DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  lastStatusUpdate DateTime? // Phase 2: Track when status last changed (for task aging)
  appointmentTime  DateTime? // Appointment/visit time for task (for sorting purposes)
  slaDeadline      DateTime
  slaBreachedAt    DateTime?
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  isArchived        Boolean @default(false)
  escalationChainId Int?

  // W5 — Snooze. Agent presses "Ping me in 15m"; the task drops out of
  // their Active list until this timestamp passes. Null when not snoozed.
  // Filter at query time — no scheduler, no auto-clear; the task simply
  // re-appears once `snoozedUntil < now`.
  snoozedUntil DateTime? @db.Timestamptz(3)

  // C1.1: Assignment tracking fields for Foundation feature
  assignmentMethod String? // "auto" | "manual" | null
  assignmentRuleId String? // Which rule auto-assigned (if method=auto)

  // Multi-source fields (Phase 1)
  source               String?   @default("orders") // "orders", "appointments", "camps"
  sourceType           String? // "BLOOD_TEST", "CONSULTATION", etc.
  sourceStatus         String? // Current status in source system
  sourceEntityId       BigInt? // ID in source system (for cross-referencing)
  sourceLastSyncedAt   DateTime? // When we last synced status back to source
  sourceHandlerContext Json? // Source-specific context for sync logic

  taskRule        TaskRule            @relation(fields: [taskRuleId], references: [id])
  taskType        TaskType?           @relation(fields: [taskTypeId], references: [id])
  assignedTo      User?               @relation("AssignedTo", fields: [assignedToId], references: [id])
  teamMember      TeamMember?         @relation(fields: [teamMemberId], references: [id])
  checklistItems  TaskChecklistItem[]
  history         TaskHistory[]
  alerts          Alert[]
  escalationChain EscalationChain?    @relation(fields: [escalationChainId], references: [id])

  @@unique([taskRuleId, entityId]) // C1.1: Prevent duplicate active tasks
  @@index([entityType, entityId])
  @@index([source]) // Multi-source index
  @@index([source, sourceEntityId]) // Multi-source cross-reference
  @@index([status])
  @@index([assignedToId])
  @@index([slaDeadline])
  @@index([storeId])
  @@index([isArchived])
  @@index([appointmentTime, priority, createdAt]) // C1.1: Compound index for sorting
  @@index([status, priority, createdAt]) // C1.1: Compound index for status sort
  @@map("tasks")
}

// C1.2: Database polling lock (prevent concurrent polling)
model PollingLock {
  id          Int      @id @default(autoincrement())
  lockKey     Int      @unique // Fixed value = 1000
  lockedAt    DateTime @default(now())
  lockedUntil DateTime
  lockedBy    String   @default("")

  @@map("polling_locks")
}

model EngineCheckpoint {
  id         Int      @id @default(autoincrement())
  sourceKey  String   @unique // e.g. "labstack:orders"
  // TIMESTAMPTZ, not the Prisma-default TIMESTAMP. The checkpoint is a
  // cursor compared against labstack `updatedAt` values; storing it as
  // naive TIMESTAMP under a session timezone of Asia/Kolkata caused a
  // 5h30m drift between write and read paths (pg shifted the write
  // into IST naive, then read returned that naive value as if it were
  // UTC). With TIMESTAMPTZ the absolute instant is preserved regardless
  // of session timezone. Verified: prod checkpoint was 5h30 in the
  // future, causing the poller to fetch 0 rows for ~5.5h until real
  // wall-clock caught up.
  lastSeenAt DateTime @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@map("engine_checkpoints")
}

model TaskChecklistItem {
  id         Int       @id @default(autoincrement())
  taskId     Int
  stepOrder  Int
  stepText   String
  isRequired Boolean   @default(true)
  isDone     Boolean   @default(false)
  doneAt     DateTime?
  createdAt  DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_checklist_items")
}

model TaskHistory {
  id          Int        @id @default(autoincrement())
  taskId      Int
  status      TaskStatus
  changedById Int?
  note        String?
  createdAt   DateTime   @default(now())

  task      Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@map("task_history")
}

// ─────────────────────────────────────────────
// ESCALATION
// ─────────────────────────────────────────────

model EscalationChain {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  levels EscalationLevel[]
  rules  TaskRule[]
  tasks  Task[]

  @@map("escalation_chains")
}

model EscalationLevel {
  id           Int    @id @default(autoincrement())
  chainId      Int
  levelNumber  Int
  delayMinutes Int    @default(0)
  channelType  String @default("IN_APP") // "IN_APP" | "WHATSAPP"
  notifyUserId Int

  chain      EscalationChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  notifyUser User            @relation(fields: [notifyUserId], references: [id])

  @@unique([chainId, levelNumber])
  @@map("escalation_levels")
}

// ─────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────

model Alert {
  id             Int          @id @default(autoincrement())
  alertType      AlertType
  severity       TaskPriority
  entityType     String?
  entityId       Int?
  taskId         Int?
  userId         Int?
  message        String
  metadata       Json?
  channel        AlertChannel @default(IN_APP)
  status         AlertStatus  @default(PENDING)
  acknowledgedAt DateTime?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())

  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([userId, status])
  @@map("alerts")
}

// ─────────────────────────────────────────────
// POLLING LOG
// ─────────────────────────────────────────────

model PollingLog {
  id           Int       @id @default(autoincrement())
  // W5 — TIMESTAMPTZ so `new Date()` round-trips cleanly. The DB session
  // tz is IST; naive timestamp columns silently shift values by +5:30.
  startedAt    DateTime  @db.Timestamptz(3)
  finishedAt   DateTime? @db.Timestamptz(3)
  durationMs   Int?
  ordersFound  Int       @default(0)
  tasksCreated Int       @default(0)
  status       String    @default("SUCCESS") // "SUCCESS" | "ERROR"
  errorMessage String?
  // W4 — per-cycle observability. Stores `{ perRule: RuleCycleStats[] }` so
  // operators can see which rules fired vs skipped without grepping logs.
  metadata     Json?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@map("polling_logs")
}

model SlaBreachLog {
  id            Int       @id @default(autoincrement())
  taskId        Int
  taskRuleId    String
  entityType    String
  entityId      Int
  assignedToId  Int?
  slaDeadline   DateTime
  breachedAt    DateTime
  breachMinutes Int
  rootCauseTag  String?
  resolvedAt    DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  @@map("sla_breach_logs")
}

// ─────────────────────────────────────────────
// MULTI-SOURCE SUPPORT (Phase 1)
// ─────────────────────────────────────────────

enum DataSourceType {
  DATABASE // Direct database connection
  API // External API
  WEBHOOK // Webhook-based events
}

enum SourceSyncStrategy {
  NONE // No sync-back to source
  API // Call source API on task status change
  DATABASE // Update source database directly
  WEBHOOK // Send webhook to source system
}

model DataSource {
  id          String  @id @default(cuid())
  sourceId    String  @unique // "orders", "appointments", "camps"
  displayName String // "Lab Orders", "Patient Appointments"
  description String?

  // Schema configuration
  tableReference  String // "public.orders" or API endpoint
  primaryKeyField String @default("id")
  typeFieldName   String // "orderType", "appointmentType"
  statusFieldName String // "orderStatus", "appointmentStatus"

  // Query configuration
  queryTemplate String // SQL with $since placeholder

  // Metadata mapping: {patientName: "patient_name", ...}
  metadataFieldMapping Json?

  // Enum values for USER-DEFINED fields: ["CONSULTATION", "HOME_SAMPLE", "INJECTION"]
  typeFieldEnumValues   Json?
  statusFieldEnumValues Json?

  // Analytics contract (Source Load panel). Unifies analytics config into
  // the single source definition so registering a source here makes it
  // available in analytics with no code change. Shape:
  //   { eventTimeField?, createdField?, eventTimeLabel?, lookaheadDays?,
  //     statusFulfilled?: string[], statusFailed?: string[] }
  // All optional — a source with no analyticsConfig still gets the Tier-0
  // heatmap (on createdField) and Tier-1 status distribution by default.
  // table / statusField / dimension are DERIVED from the columns above
  // (tableReference / statusFieldName / typeFieldName), not duplicated.
  analyticsConfig Json?

  // Polling configuration
  pollingType            DataSourceType @default(DATABASE)
  pollingIntervalMinutes Int            @default(5)
  isActive               Boolean        @default(true)

  // Sync-back configuration
  syncStrategy    SourceSyncStrategy @default(NONE)
  syncEndpoint    String? // API endpoint or webhook URL
  syncCredentials Json? // Encrypted credentials for sync

  // Backfill configuration
  backfillEnabled     Boolean   @default(false)
  backfillDays        Int       @default(7)
  backfillCompleted   Boolean   @default(false)
  backfillCompletedAt DateTime?

  // Auditing
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById Int
  createdBy   User     @relation("DataSourceCreatedBy", fields: [createdById], references: [id])

  // Relations
  pollingLogs  DataSourcePollingLog[]
  ruleScopes   TaskRuleSourceScope[]
  capabilities TeamMemberCapability[]
  taskRules    TaskRule[]

  @@index([sourceId])
  @@index([isActive])
  @@map("data_sources")
}

model DataSourcePollingLog {
  id String @id @default(cuid())

  dataSourceId String
  dataSource   DataSource @relation(fields: [dataSourceId], references: [id])

  // Timing
  pollStartedAt   DateTime
  pollCompletedAt DateTime?
  durationMs      Int?

  // Results
  entitiesFound     Int @default(0)
  entitiesProcessed Int @default(0)
  tasksCreated      Int @default(0)
  tasksFailed       Int @default(0)

  // Status
  status       String // "PENDING", "IN_PROGRESS", "SUCCESS", "ERROR", "PARTIAL"
  errorMessage String?

  // Details JSON: {entitiesByType: {...}, failedEntities: [...], ...}
  details Json?

  createdAt DateTime @default(now())

  @@index([dataSourceId])
  @@index([status])
  @@index([createdAt])
  @@map("data_source_polling_logs")
}

model TaskRuleSourceScope {
  id String @id @default(cuid())

  taskRuleId String
  taskRule   TaskRule @relation(fields: [taskRuleId], references: [id], onDelete: Cascade)

  dataSourceId String
  dataSource   DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  // Scope definition
  allowedTypes    Json // ["BLOOD_TEST", "CONSULTATION"] - JSON array of strings
  allowedStatuses Json // ["CREATED", "PENDING"] - JSON array of strings

  // Assignment strategy
  assignmentStrategy       String @default("default") // "route_by_store", "round_robin", etc.
  assignmentStrategyConfig Json?

  // SLA override (for this source)
  slaMinutesOverride Int?

  // Status
  isActive Boolean @default(true)

  // Auditing
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById Int
  createdBy   User     @relation("RuleSourceScopeCreatedBy", fields: [createdById], references: [id])

  @@unique([taskRuleId, dataSourceId])
  @@index([dataSourceId])
  @@index([isActive])
  @@map("task_rule_source_scopes")
}

// ─────────────────────────────────────────────
// TASK MODEL EXTENSIONS (For multi-source)
// ─────────────────────────────────────────────

// Note: Add these fields to existing Task model:
// source              String?           // "orders", "appointments", "camps"
// sourceType          String?           // "BLOOD_TEST", "CONSULTATION", etc.
// sourceStatus        String?           // Current status in source system
// sourceEntityId      BigInt?           // ID in source system
// sourceLastSyncedAt  DateTime?         // When we last synced status back to source
// sourceHandlerContext Json?            // Source-specific context for sync logic
//
// Also add indexes:
// @@index([source])
// @@index([source, sourceEntityId])

// ─────────────────────────────────────────────
// WHATSAPP CONTROL TOWER (Phase 1)
// The 49 partner/provider WhatsApp groups become a single console inbox.
// The Baileys gateway writes inbound messages here and drains the outbound
// queue; OpsFlow renders tickets and enqueues replies. Postgres is the bus.
// ─────────────────────────────────────────────

enum WaGroupRole {
  SUPPORT // partner group where queries arrive (we listen + answer)
  PROVIDER // lab/provider coordination group (we send here)
  INTERNAL // internal ops group
  IGNORE // do not surface in the console
}

enum WaTicketStatus {
  NEW
  OPEN
  WAITING_INFO // asked the partner for an id / details
  WAITING_LAB // pinged the provider/lab group
  ANSWERED
  RESOLVED
}

enum WaMsgDirection {
  IN
  OUT
}

enum WaOutboundStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

model WaGroup {
  id                 String      @id @default(cuid())
  jid                String      @unique // WhatsApp group jid (…@g.us)
  subject            String // group name
  role               WaGroupRole @default(SUPPORT)
  storeId            Int? // SUPPORT → partner/store (no FK, mirrors Task.storeId)
  labId              Int? // PROVIDER → lab
  autoAskIdOnMissing Boolean     @default(false) // auto-reply asking for an id; OFF by default + gated by WA_AUTO_ASK
  sendEnabled        Boolean     @default(false) // per-group send guard
  active             Boolean     @default(true) // listening on/off
  lastReadAt         DateTime? // console: inbound messages after this count as unread
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  messages WaMessage[]
  tickets  WaTicket[]
  outbound WaOutbound[]

  @@index([role])
  @@index([active])
  @@map("wa_groups")
}

model WaMessage {
  id           String         @id @default(cuid())
  waMsgId      String         @unique // WhatsApp message id → idempotent ingest
  groupId      String
  ticketId     String?
  direction    WaMsgDirection @default(IN)
  fromMe       Boolean        @default(false)
  sender       String // pushName
  senderJid    String? // participant jid/lid — used to match the LS team roster
  text         String
  mediaType    String? // image / document / etc.
  ts           DateTime // message timestamp
  replyToWaId  String? // quoted message id (WhatsApp reply)
  intent       String? // classifier output
  orderIds     Int[]          @default([]) // VALIDATED canonical Order ids only
  requestIds   Int[]          @default([]) // VALIDATED Request ids only
  refIds       String[]       @default([]) // lab reference ids (BLR…/HYD…) seen in the text
  idType       String? // provenance of the primary id: REF / ORDER / REQUEST / APPOINTMENT
  idVia        String? // human trail, e.g. "appt 21877" or "request 15021"
  ambiguousIds Int[]          @default([]) // bare numbers we would NOT guess (need clarification)
  mediaPath    String? // stored media object key/path (images/docs)
  mediaMime    String? // media mime type
  ocrText      String? // extracted text from an image/doc
  ocrJson      Json? // structured interpretation of the media
  raw          Json?
  createdAt    DateTime       @default(now())

  group  WaGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  ticket WaTicket? @relation(fields: [ticketId], references: [id])

  @@index([groupId, ts])
  @@index([ticketId])
  @@index([ts])
  @@map("wa_messages")
}

// Raw media bytes for image/document messages, kept in the shared taskos DB so
// the console container can serve them without a shared filesystem with the
// gateway. One row per WhatsApp message; ocr* cache the vision interpretation.
model WaMedia {
  id        String   @id @default(cuid())
  waMsgId   String   @unique
  groupId   String
  mime      String
  bytes     Bytes
  ocrText   String?
  ocrJson   Json?
  createdAt DateTime @default(now())

  @@map("wa_media")
}

// LLM-synthesized case brief per order/request. A background analyst reads all
// of an order's messages (across groups) + the live LabStack state and produces
// an accurate status, cross-group timeline, resolution verdict, and in-context
// suggested replies. Keyed by the canonical order (or request) so one brief
// serves every group's case for it. inputHash lets the analyst skip re-work
// when nothing changed — bounding token spend even in continuous mode.
model WaCaseBrief {
  id             String   @id @default(cuid())
  orderId        Int?     @unique
  requestId      Int?     @unique
  queryType      String? // canonical query type the LLM classified (kills "other")
  status         String? // plain-English current status
  resolved       Boolean  @default(false)
  resolvedReason String?
  waiting        String? // who is waiting on whom / the next action
  timeline       Json? // [{ ts, actor, role, event }]
  suggestions    Json? // { store: "...", lab: "..." }
  actors         Json? // optional per-sender role map
  model          String?
  inputHash      String? // hash of the analyzed inputs; skip re-run when unchanged
  analyzedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@map("wa_case_briefs")
}

model WaTicket {
  id                String         @id @default(cuid())
  groupId           String
  storeId           Int?
  origin            String         @default("CUSTOMER") // CUSTOMER query (CX group) | PROVIDER request (lab group)
  status            WaTicketStatus @default(NEW)
  orderId           Int?
  requestId         Int?
  entityKind        String? // ORDER | REQUEST | APPOINTMENT — the namespace the id was resolved to
  idConfidence      String? // high | low — how sure the resolver is this is the right entity
  idWarning         String? // staleness / contradiction note (e.g. "order delivered 238d before the chat")
  idAlt             Json? // { kind, id } — the runner-up candidate, for a one-click switch
  intent            String?
  contextSnapshot   Json? // order/request context captured from the replica
  assignedToId      Int? // User.id (no FK, mirrors Task assignment pattern)
  slaDueAt          DateTime?
  firstMessageId    String?
  firstResponseAt   DateTime? // when our team first responded (native or console)
  respondedVia      String? // "native" (WhatsApp app) | "console"
  lastResponderName String? // team member who last responded
  lastActivityAt    DateTime       @default(now())
  resolvedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  group    WaGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  messages WaMessage[]
  outbound WaOutbound[]

  @@index([status])
  @@index([groupId])
  @@index([orderId])
  @@index([assignedToId])
  @@index([lastActivityAt])
  @@map("wa_tickets")
}

model WaOutbound {
  id          String           @id @default(cuid())
  targetJid   String // group jid or <number>@s.whatsapp.net
  text        String
  status      WaOutboundStatus @default(QUEUED)
  ticketId    String?
  groupId     String?
  createdById Int? // User.id who composed it (no FK)
  attempts    Int              @default(0)
  error       String?
  sentWaMsgId String?
  quotedWaId  String? // reply-to a specific inbound message
  mentions    Json? // array of jids to @-mention (the text carries "@<localpart>")
  mediaMime   String? // when set, this outbound carries an attachment
  mediaName   String? // original filename (documents)
  mediaBytes  Bytes? // the attachment bytes (short-lived; sent then done)
  // When set, the gateway sends a WhatsApp POLL instead of a plain text body —
  // how a provider answers accept / reschedule / cannot-fulfil without a link.
  // pollOptions is [{ label, action }] in display order; the gateway copies it
  // onto the WaPoll row so an incoming vote maps back to a LabProviderActionType.
  pollName    String?
  pollOptions Json?
  createdAt   DateTime         @default(now())
  // When the gateway began handing this row to WhatsApp. Distinct from
  // createdAt, which is when it was queued: a row can sit QUEUED for hours
  // behind a backlog or a disconnected gateway, so "has this send stalled?"
  // can only be measured from here.
  sendingAt   DateTime?
  sentAt      DateTime?

  ticket WaTicket? @relation(fields: [ticketId], references: [id])
  group  WaGroup?  @relation(fields: [groupId], references: [id])

  @@index([status])
  @@index([ticketId])
  @@map("wa_outbound")
}

// One poll the gateway put in a provider group, and the vote that came back.
//
// This is the hand-off between the two processes. The gateway owns sending and
// decryption (only it holds the WhatsApp session); the console owns the
// workflow state machine. Rather than have the gateway call the app over HTTP —
// which would drop votes whenever the app is restarting — a vote is recorded
// here and the every-minute tick applies it.
//
// `messageJson` is the poll creation message as Baileys returned it. Poll votes
// arrive encrypted and can only be opened with the original message's
// `messageSecret`, so it has to survive a gateway restart.
model WaPoll {
  waMsgId    String  @id // the poll creation message id
  outboundId String? @unique // the wa_outbound row that sent it
  workflowId String? // the confirmation workflow this poll is asking about
  // [{ label, action }] in display order. Votes come back as the option TEXT,
  // so this is what turns "Cannot fulfil" into REJECT.
  options     Json
  messageJson Json

  status      WaPollStatus           @default(PENDING)
  // The option TEXT that was tapped. votedAction alone is not enough: an
  // informational option has no action, and two options may share one, so the
  // label is what identifies which reply to send.
  votedLabel  String?
  votedAction LabProviderActionType?
  voterJid    String?
  votedAt     DateTime?

  // A poll tap carries no text, so REJECT/RESCHEDULE ask for a follow-up in the
  // group. The gateway sets awaitingReason, then fills reason from that
  // person's next message.
  awaitingReason Boolean   @default(false)
  reason         String?
  reasonAt       DateTime? // when the provider sent it
  // The vote is applied as soon as it lands, so reminders stop immediately;
  // a reason that turns up afterwards is a second, separate write. This marks
  // it done so the tick does not re-attach the same text every minute.
  reasonAppliedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([workflowId])
  @@index([awaitingReason])
  @@map("wa_polls")
}

enum WaGatewayStatus {
  CONNECTING
  QR // waiting for an admin to scan
  CONNECTED
  LOGGED_OUT // needs a re-scan
}

// Singleton (id="default") — the bridge between the Baileys gateway and the
// admin Setup screen. The gateway writes status/qr/connectedNumber/lastSeenAt;
// the console reads them to render the connection card + live QR, and writes
// `command` (RELINK / LOGOUT) which the gateway consumes.
model WaGateway {
  id                 String          @id @default("default")
  status             WaGatewayStatus @default(CONNECTING)
  qr                 String? // current raw QR payload (present when status = QR)
  qrUpdatedAt        DateTime?
  connectedNumber    String? // e.g. 919522584955
  lastSeenAt         DateTime?
  dryRun             Boolean? // gateway's DRY_RUN kill switch — true = nothing sends
  command            String? // "RELINK" | "LOGOUT" | "BACKFILL" — set by admin, cleared by gateway
  commandRequestedAt DateTime?
  updatedAt          DateTime        @updatedAt

  @@map("wa_gateway")
}

// LS internal team roster (uploaded by admins). Used to identify which
// messages are OUR team's replies vs incoming customer/partner messages, and
// to attribute who is handling what. Match by phone (from the sender jid) or
// by name/alias (pushName).
model WaContact {
  id        String   @id @default(cuid())
  name      String
  phone     String? // normalized digits
  aliases   String[] @default([]) // pushName variants seen in groups
  team      String? // e.g. "Store ops", "Lab desk"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@map("wa_contacts")
}

// ─────────────────────────────────────────────
// NON-API LAB COMMUNICATION AUTOMATION (MVP)
//
// LabStack remains the source of truth for labs, orders, patients and
// appointments. These records deliberately store the external ids and a
// minimal order snapshot rather than duplicating source-domain tables.
// ─────────────────────────────────────────────

// ── SLA milestone breach (all labs, API and NON_API) ────────────────────
// Deliberately keyed on the ORDER and the LAB, never on a communication
// workflow: an API lab never has one, and this feature covers both.

enum SlaMilestone {
  ORDER_CONFIRMED
  PHLEBO_ASSIGNED
  SAMPLE_COLLECTED
  SAMPLE_DELIVERED
  REPORT_UPLOADED
}

// Which clock a milestone's deadline hangs off. Conflating these is the
// dangerous bug in this feature, so the anchor is always explicit and stored.
enum SlaAnchor {
  ORDER_CREATED
  APPOINTMENT_TIME
  PREV_MILESTONE_COMPLETED
}

enum SlaBreachStatus {
  ACTIVE
  RESOLVED
  CAPPED
  CANCELLED
}

// A path step is either part of the timed sequence or a conditional breach
// watcher. Breach steps never participate in sequence ordering — see the
// comment on ProviderCommunicationRule.triggerKind.
enum StepTriggerKind {
  RELATIVE_DELAY
  SLA_BREACH
}

enum LabIntegrationType {
  API
  NON_API
}

enum LabCommunicationWorkflowStatus {
  WAITING_FOR_LAB_CONFIRMATION
  LAB_ACCEPTED
  LAB_RESCHEDULE_REQUESTED
  LAB_REJECTED
  ESCALATED
  COMPLETED
  CANCELLED
}

enum LabCommunicationChannel {
  WHATSAPP
}

enum LabCommunicationType {
  INITIAL_NOTIFICATION
  REMINDER
  ESCALATION
  MANUAL_RESEND
  // Fired by the SLA watcher when an OpsFlow task for the order breaches its
  // deadline. Unlike the four above it is NOT part of the confirmation
  // workflow — it applies to API labs too, which never run that workflow — so
  // a SLA_BREACH row is the one kind that can carry a null workflowId.
  SLA_BREACH
  // The once-a-day wrap-up: what the provider handled today and what lands
  // tomorrow. The only type that is about a DAY rather than an order, so it
  // carries a null orderId as well as a null workflowId.
  DAILY_DIGEST
}

enum LabCommunicationStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  SUPPRESSED
  ACTION_TAKEN
}

enum LabScheduledActionType {
  SEND_REMINDER
  ESCALATE
}

// Which clock a scheduled action hangs off. ORDER offsets are positive
// (minutes after we first saw the order); APPOINTMENT offsets are negative
// (minutes before the patient is due). See lib/non-api-labs/ladder.ts.
enum LabScheduleAnchor {
  ORDER
  APPOINTMENT
}

enum LabScheduledActionStatus {
  PENDING
  RUNNING
  COMPLETED
  CANCELLED
  FAILED
  SUPPRESSED
}

enum LabProviderActionType {
  ACCEPT
  RESCHEDULE
  REJECT
}

// An editable poll: the question, the options, and what each option replies.
//
// Poll options used to be a hardcoded array and the reply to a tap a fixed
// template chosen by action, which meant a new kind of poll — an SLA breach
// asking "what is happening with this sample?" — needed code. This makes both
// halves data: Ops writes the options and the acknowledgement for each one, and
// any message that wants a poll names a definition by key.
//
// `options` is [{ label, action, ack }]:
//   label   what the provider taps, and what the vote comes back as
//   action  optional workflow effect (ACCEPT/RESCHEDULE/REJECT); null means the
//           answer is informational — an SLA breach has no workflow to move
//   ack     the reply sent when this option is chosen, with {{order_id}} etc.
//
// The resolved options are COPIED onto each wa_polls row when the poll is sent,
// so editing a definition never changes what an already-sent poll means.
model WaPollDefinition {
  id       String  @id @default(cuid())
  key      String  @unique // ORDER_CONFIRMATION, SLA_BREACH, or an Ops-made one
  name     String // what this poll is called in the console
  question String // the question WhatsApp shows above the options
  isActive Boolean @default(true)
  options  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wa_poll_definitions")
}

// Lifecycle of one poll the gateway put in a provider group.
//   PENDING  — sent, nobody has voted yet
//   VOTED    — the gateway decrypted a vote; the console has not applied it
//   APPLIED  — the workflow state machine has consumed it
// The gateway only ever writes PENDING → VOTED, the console only VOTED →
// APPLIED, so neither can clobber the other's work.
enum WaPollStatus {
  PENDING
  VOTED
  APPLIED
}

enum LabEscalationStatus {
  OPEN
  NOTIFIED
  RESOLVED
  CANCELLED
}

enum LabOrderEventType {
  ORDER_DETECTED
  WORKFLOW_STARTED
  MESSAGE_QUEUED
  MESSAGE_SENT
  MESSAGE_DELIVERED
  MESSAGE_READ
  ACTION_LINK_OPENED
  LAB_ACCEPTED
  LAB_RESCHEDULE_REQUESTED
  LAB_REJECTED
  REMINDER_SCHEDULED
  REMINDER_SENT
  REMINDER_SUPPRESSED
  ESCALATION_TRIGGERED
  WORKFLOW_CANCELLED
  // Something the provider told us that moves no state — an informational poll
  // answer, or the note that follows one. Recorded so the desk can read it.
  PROVIDER_NOTE
}

// Editable message content. The renderer validates every {{variable}} before
// enqueueing a message, so a broken template never silently sends malformed
// operational information to a lab.
model LabCommunicationTemplate {
  id          String                  @id @default(cuid())
  key         String                  @unique
  name        String
  channel     LabCommunicationChannel @default(WHATSAPP)
  body        String
  isActive    Boolean                 @default(true)
  createdById Int?
  updatedById Int?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([channel, isActive])
  @@map("lab_communication_templates")
}

// One provider-communication configuration per external LabStack lab. The
// external Lab row itself is never written by OpsFlow.
//
// This used to describe NON_API labs only. It now covers both integration
// types, because the two triggers it drives have different audiences:
//
//   confirmation ladder  NON_API only — an API lab already received the order
//                        over the API, so asking it to accept/reschedule over
//                        WhatsApp would be noise.
//   SLA breach alert     both — "your order has blown its deadline" is worth
//                        sending whichever way the order reached the lab.
//
// So an API lab's row is legitimate and useful even though it schedules no
// ladder; see lib/provider-comms/sla-breach.ts.
model NonApiLabConfig {
  labId                       Int                @id
  labName                     String
  integrationType             LabIntegrationType @default(NON_API)
  // Where messages to this provider go. Exactly one is needed:
  //   waGroupJid     — a WhatsApp GROUP ("…@g.us"). Preferred: the provider's
  //                    ops group, where a reply is visible to their whole desk.
  //   whatsappNumber — a single handset, as a DM.
  // A group target always routes through a wa_groups row so the gateway's
  // per-group sendEnabled guard applies; see lib/non-api-labs/target.ts.
  waGroupJid                  String?
  whatsappNumber              String?
  managerName                 String?
  managerWhatsapp             String?
  isActive                    Boolean            @default(true)
  confirmationSlaMinutes      Int                @default(60)
  reminderSlaMinutes          Int                @default(180)
  escalationSlaMinutes        Int                @default(300)
  initialTemplateKey          String             @default("NON_API_NEW_ORDER")
  reminderTemplateKey         String             @default("NON_API_REMINDER")
  escalationTemplateKey       String             @default("NON_API_ESCALATION")
  appointmentTemplateKey      String             @default("NON_API_APPOINTMENT_REMINDER")
  // Appointment-anchored reminders (T-24h/-2h/-30m/-10m) can be turned off per
  // lab; the order clock always runs.
  appointmentRemindersEnabled Boolean            @default(true)
  // Minimum gap between two messages about the SAME order, across both clocks.
  // Confirmation ladder only: breach alerts are capped per order instead, and
  // lib/provider-comms/sla-breach.ts explains why applying this to them would
  // suppress nearly every alert for a busy lab.
  quietWindowMinutes          Int                @default(10)
  // Message this lab when an OpsFlow task for one of its orders breaches SLA.
  // Applies to API and NON_API labs alike; off by lab, not by integration type.
  slaBreachAlertsEnabled      Boolean            @default(true)
  slaBreachTemplateKey        String             @default("PROVIDER_SLA_BREACH")
  // Breach alerts are per task, but one order can breach several task rules in
  // a row. This caps how many reach the provider for a single order; further
  // breaches are still recorded by the SLA watcher, just not re-sent.
  slaBreachMaxPerOrder        Int                @default(2)
  // ── Daily digest ─────────────────────────────────────────────────────────
  // One message a day: how today went, and what lands tomorrow. Off by
  // default — a recurring broadcast to a real provider group is something a
  // human turns on per lab, never something a deploy starts doing.
  dailyDigestEnabled          Boolean            @default(false)
  // Local clock (TIMEZONE), not UTC: "send at 19:00" means the provider's
  // 19:00. Evening by default, when today is done and tomorrow is plannable.
  dailyDigestHour             Int                @default(19)
  dailyDigestMinute           Int                @default(0)
  dailyDigestTemplateKey      String             @default("PROVIDER_DAILY_DIGEST")
  // A digest saying "0 today, 0 tomorrow" every evening trains the provider to
  // ignore the whole thread, so by default a quiet day sends nothing. Labs
  // that want the daily heartbeat regardless can turn this off.
  dailyDigestSkipWhenEmpty    Boolean            @default(true)
  createdById                 Int?
  updatedById                 Int?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  @@index([integrationType, isActive])
  @@map("non_api_lab_configs")
}

// One authored answer to "when does OpsFlow message a provider, and with
// what". The built-in ladder in lib/non-api-labs/ladder.ts remains the
// fallback for labs no rule covers; a rule that matches replaces it.
//
// Two halves, deliberately separated:
//   - the SCOPE + ANCHOR + OFFSET decide when a message is *scheduled*, at
//     workflow start (plan time);
//   - `sendCondition` decides whether it is still worth *sending* when that
//     moment arrives (send time), re-evaluated against LabStack every tick.
model ProviderCommunicationRule {
  id                    String                 @id @default(cuid())
  name                  String
  isActive              Boolean                @default(true)
  // Scope. Empty array means "every configured provider lab" / "every order
  // type" — the same convention TaskRule.allowedTypes uses.
  allowedLabIds         Json                   @default("[]")
  allowedOrderTypes     Json                   @default("[]")
  anchor                LabScheduleAnchor
  action                LabScheduledActionType
  offsetMinutes         Int
  // P0..P4, P0 most urgent. Only breaks ties when two rules come due together.
  priority              Int                    @default(4)
  templateKey           String
  // Who the message goes to. An escalation that lands back in the inbox that
  // has been ignoring us is not an escalation.
  recipient             String                 @default("LAB")
  // Send-time gates. See SendCondition in lib/non-api-labs/rules.ts.
  sendCondition         Json                   @default("{}")
  // RELATIVE_DELAY = a timed sequence step, scheduled when the order arrives.
  // SLA_BREACH     = a conditional watcher fired by the milestone engine.
  //
  // Breach steps are EXCLUDED from loadActiveCommunicationRules(), and that
  // exclusion is load-bearing: workflow.ts does
  //   `scopedRules.length > 0 ? ruleActions : buildLadder(...)`
  // so any rule visible to that path replaces the provider's entire built-in
  // ladder. Without the exclusion, adding one breach step would silently
  // delete every sequence step the provider had.
  triggerKind           StepTriggerKind        @default(RELATIVE_DELAY)
  // Required exactly when triggerKind = SLA_BREACH; NULL otherwise. Enforced
  // by a CHECK constraint in the migration as well as at the API layer.
  slaMilestone          SlaMilestone?
  // Per-step overrides for the lab's SlaMilestoneConfig cadence. NULL inherits.
  repeatIntervalMinutes Int?
  maxAttempts           Int?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([name])
  @@index([triggerKind, isActive])
  @@index([isActive])
  @@map("provider_communication_rules")
}

// ── SLA milestone breach ────────────────────────────────────────────────
//
// Every DateTime below is Timestamptz(3). The rest of this module stores
// naive `timestamp`, so never compare these columns to a legacy one in raw
// SQL without an explicit cast — the session TZ here is Asia/Kolkata and that
// mismatch is exactly how this product's timezone incidents happened. Through
// Prisma both shapes arrive as correct JS Dates, which is how the engine
// reads them.

/// One row per (lab, milestone). `labId = NULL` is the global default a lab
/// row overrides. Postgres treats NULLs as distinct in a unique index, so the
/// single-global-row guarantee is a partial unique index in the migration,
/// not the @@unique below (which only covers the per-lab rows).
model SlaMilestoneConfig {
  id                    String       @id @default(cuid())
  labId                 Int?
  milestone             SlaMilestone
  anchor                SlaAnchor
  /// Signed. -60 = sixty minutes BEFORE the anchor. Always minutes.
  offsetMinutes         Int
  /// Ships false. A milestone the resolver cannot verify must stay off, or it
  /// breaches on every order.
  enabled               Boolean      @default(false)
  repeatIntervalMinutes Int          @default(30)
  /// Total messages including the first.
  maxAttempts           Int          @default(3)
  ignoreQuietHours      Boolean      @default(false)
  createdAt             DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([labId, milestone])
  @@index([enabled])
  @@map("sla_milestone_configs")
}

/// The ledger. `(orderId, milestone)` is the idempotency guarantee: detection
/// upserts on it and never reads first, so repeated ticks and concurrent
/// runners cannot produce a second event.
model SlaBreachEvent {
  id               String          @id @default(cuid())
  /// LabStack public."Order".id — deliberately not a foreign key, same as
  /// LabCommunicationWorkflow.orderId.
  orderId          Int
  labId            Int
  milestone        SlaMilestone
  deadlineAt       DateTime        @db.Timestamptz(3)
  firstBreachedAt  DateTime        @db.Timestamptz(3)
  attemptsSent     Int             @default(0)
  lastSentAt       DateTime?       @db.Timestamptz(3)
  /// NULL once the event is done. `status = ACTIVE AND nextAttemptAt <= now()`
  /// is the whole engine query — no in-memory timers, restart-safe.
  nextAttemptAt    DateTime?       @db.Timestamptz(3)
  status           SlaBreachStatus @default(ACTIVE)
  resolvedAt       DateTime?       @db.Timestamptz(3)
  /// MILESTONE_COMPLETED | ORDER_CANCELLED | RESCHEDULED | MAX_ATTEMPTS | MANUAL_STOP
  resolutionReason String?
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)

  sends SlaBreachSend[]

  @@unique([orderId, milestone])
  @@index([status, nextAttemptAt])
  @@index([labId, status])
  @@map("sla_breach_events")
}

/// One row per attempt, written BEFORE the enqueue. Create-then-send means a
/// crash between the two can only lose a message, never duplicate one.
model SlaBreachSend {
  id            String   @id @default(cuid())
  breachEventId String
  attemptNo     Int
  /// The ProviderCommunicationRule (breach step) that produced this message.
  /// Not a foreign key: deleting a step must not erase what it already sent.
  ruleId        String?
  /// FK into the existing outbound queue, for delivery status. NULL on a dry
  /// run, and briefly NULL between the row being written and the enqueue.
  waOutboundId  String?
  /// Group JID or number actually used.
  destination   String
  /// Exactly what was sent, for the audit trail.
  renderedBody  String
  sentAt        DateTime @db.Timestamptz(3)
  dryRun        Boolean  @default(false)

  breachEvent SlaBreachEvent @relation(fields: [breachEventId], references: [id], onDelete: Cascade)

  @@unique([breachEventId, attemptNo])
  @@index([waOutboundId])
  @@map("sla_breach_sends")
}

/// Single row, id "default". Exists so the kill switch and dry run can be
/// flipped without a deploy — the gateway's DRY_RUN env stops sequence sends
/// too, so it cannot serve as a breach-only switch.
model ProviderCommsSettings {
  id                 String   @id @default("default")
  /// Master switch for SLA-breach sending only. Sequence steps are unaffected.
  slaBreachEnabled   Boolean  @default(false)
  /// Renders and records every attempt, advances attempt state, enqueues nothing.
  slaBreachDryRun    Boolean  @default(true)
  /// Clock-hour quiet window in TIMEZONE. Attempts defer to the next opening
  /// unless the milestone sets ignoreQuietHours.
  quietHoursStart    Int?
  quietHoursEnd      Int?
  /// Max breach messages per lab per tick. Excess rolls to the next tick.
  perLabPerTickLimit Int      @default(2)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  @@map("provider_comms_settings")
}

// Idempotency boundary for the source Order-created event. `orderId` belongs
// to LabStack's public.Order, and is intentionally not a foreign key here.
model LabCommunicationWorkflow {
  id                    String                         @id @default(cuid())
  orderId               Int                            @unique
  labId                 Int
  status                LabCommunicationWorkflowStatus @default(WAITING_FOR_LAB_CONFIRMATION)
  sourceOrderStatus     String?
  orderSnapshot         Json
  appointmentTime       DateTime?
  confirmationDeadline  DateTime
  reminderDeadline      DateTime
  escalationDeadline    DateTime
  acceptedAt            DateTime?
  rescheduleRequestedAt DateTime?
  rejectedAt            DateTime?
  rejectionReason       String?
  cancelledAt           DateTime?
  completedAt           DateTime?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  communications   LabCommunication[]
  scheduledActions LabScheduledAction[]
  actionTokens     LabProviderActionToken[]
  escalations      LabCommunicationEscalation[]
  events           LabCommunicationOrderEvent[]
  auditLogs        LabCommunicationAuditLog[]

  @@index([labId, status])
  @@index([status, confirmationDeadline])
  @@map("lab_communication_workflows")
}

// One row per requested or observed message. `waOutboundId`/providerMessageId
// bridge to the existing WhatsApp queue without coupling this workflow to a
// particular WhatsApp gateway implementation.
model LabCommunication {
  id                String                  @id @default(cuid())
  // NULL for SLA_BREACH and DAILY_DIGEST messages. Breach alerts go to API
  // labs as well, and an API lab has no confirmation workflow to hang off; a
  // digest is about a whole day and belongs to no single order. Both are why
  // the order and lab are denormalized below rather than read through the
  // relation.
  workflowId        String?
  // labId is always populated. orderId is too, except on DAILY_DIGEST rows —
  // a digest is about a lab's day, not about one order. For workflow-backed
  // rows these mirror the workflow's own orderId/labId, which keeps
  // "everything we sent this lab" a single query instead of a union across
  // two shapes.
  orderId           Int?
  labId             Int?
  channel           LabCommunicationChannel @default(WHATSAPP)
  type              LabCommunicationType
  status            LabCommunicationStatus  @default(QUEUED)
  recipient         String
  templateKey       String
  templateVariables Json
  // The ProviderCommunicationRule that produced this message, when one did.
  // NULL for the initial notification and for built-in ladder rungs. Not a
  // foreign key: deleting a rule must not erase what it already sent.
  ruleId            String?
  waOutboundId      String?                 @unique
  providerMessageId String?                 @unique
  idempotencyKey    String                  @unique
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  actionTakenAt     DateTime?
  suppressedAt      DateTime?
  failedAt          DateTime?
  failureReason     String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  workflow LabCommunicationWorkflow? @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, createdAt])
  @@index([status])
  @@index([ruleId, createdAt])
  // Drives the per-order breach cap ("have we already told this lab about
  // order N?"), which is the only repetition guard on the breach path.
  @@index([labId, createdAt])
  @@map("lab_communications")
}

// Durable jobs claimed by the process-wide poller. The unique idempotency key
// prevents a retry or duplicate order event from scheduling the same action.
model LabScheduledAction {
  id             String                   @id @default(cuid())
  workflowId     String
  type           LabScheduledActionType
  status         LabScheduledActionStatus @default(PENDING)
  // runAt is materialized (and indexed) but derived: anchor base + offsetMinutes.
  // Recomputed when the appointment moves in LabStack.
  anchor         LabScheduleAnchor        @default(ORDER)
  offsetMinutes  Int                      @default(0)
  // P0..P4, where P0 is most urgent. Breaks ties when both clocks fire together.
  priority       Int                      @default(4)
  rungKey        String?
  // Set when a ProviderCommunicationRule scheduled this action. The built-in
  // ladder leaves it NULL and identifies itself through rungKey instead.
  ruleId         String?
  runAt          DateTime
  idempotencyKey String                   @unique
  attempts       Int                      @default(0)
  lockedAt       DateTime?
  lockedBy       String?
  completedAt    DateTime?
  cancelledAt    DateTime?
  lastError      String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  workflow LabCommunicationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([workflowId])
  @@index([workflowId, status, priority], map: "lab_scheduled_actions_arbitration_idx")
  @@index([ruleId, status])
  @@map("lab_scheduled_actions")
}

// Only a cryptographic hash of the bearer token is persisted. A token is tied
// to one workflow and one permitted action, expires, and records single use.
model LabProviderActionToken {
  id         String                @id @default(cuid())
  workflowId String
  action     LabProviderActionType
  tokenHash  String                @unique
  expiresAt  DateTime
  usedAt     DateTime?
  openedAt   DateTime?
  usedIpHash String?
  createdAt  DateTime              @default(now())

  workflow LabCommunicationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, action])
  @@index([expiresAt])
  @@map("lab_provider_action_tokens")
}

model LabCommunicationEscalation {
  id          String              @id @default(cuid())
  workflowId  String
  level       Int
  status      LabEscalationStatus @default(OPEN)
  recipient   String?
  reason      String
  triggeredAt DateTime            @default(now())
  notifiedAt  DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workflow LabCommunicationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, level])
  @@index([status, triggeredAt])
  @@map("lab_communication_escalations")
}

model LabCommunicationOrderEvent {
  id         String            @id @default(cuid())
  workflowId String
  type       LabOrderEventType
  actorType  String? // LAB | OPS | SYSTEM | WEBHOOK
  actorId    String?
  payload    Json?
  occurredAt DateTime          @default(now())

  workflow LabCommunicationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, occurredAt])
  @@index([type])
  @@map("lab_communication_order_events")
}

model LabCommunicationAuditLog {
  id         String   @id @default(cuid())
  workflowId String
  action     String
  actorType  String
  actorId    String?
  requestId  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  workflow LabCommunicationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, createdAt])
  @@index([requestId])
  @@map("lab_communication_audit_logs")
}
